PORT=3001
HOST=0.0.0.0
PROVIDER_API_KEY=sodah-local-test-key-2026
CORS_ORIGIN=*

AUTH_DIR=./data/auth

# Direct AI replies
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase - optional but recommended for multi-tenant business configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Business table configuration
SUPABASE_BUSINESSES_TABLE=businesses
BUSINESS_ID_COLUMN=business_id
BUSINESS_NAME_COLUMN=business_name
BUSINESS_PROMPT_COLUMN=ai_prompt
BUSINESS_PHONE_COLUMN=ai_number
BUSINESS_CONNECTED_COLUMN=whatsapp_connected

# Optional message/customer persistence
SAVE_MESSAGES=true
SUPABASE_MESSAGES_TABLE=whatsapp_messages
SUPABASE_CUSTOMERS_TABLE=customers

# Only process private incoming chats by default.
IGNORE_GROUPS=true
IGNORE_STATUS=true
IGNORE_FROM_ME=true

# Prevent duplicate replies when WhatsApp emits the same message more than once.
MESSAGE_DEDUP_TTL_SECONDS=120

# Safety fallback when AI is unavailable.
FALLBACK_REPLY=Thanks for your message. We received it and will get back to you shortly.
